{
  "private": false,
  "name": "@fragata/fs",
  "version": "4.10.0",
  "license": "AGPL-3.0-or-later",
  "description": "The File System for Fragata backups.",
  "homepage": "https://github.com/6a8i/fragata-orchestrator/tree/main/@fragata/fs",
  "bugs": "https://github.com/6a8i/fragata-orchestrator/issues",
  "repository": {
    "directory": "@fragata/fs",
    "type": "git",
    "url": "https://github.com/6a8i/fragata-orchestrator.git"
  },
  "preferGlobal": true,
  "main": "dist/",
  "bin": {
    "fragata-fs": "./cli.js"
  },
  "engines": {
    "node": ">=14.13"
  },
  "dependencies": {
    "@aws-sdk/abort-controller": "^3.272.0",
    "@aws-sdk/client-s3": "^3.1065.0",
    "@aws-sdk/lib-storage": "^3.1065.0",
    "@aws-sdk/middleware-apply-body-checksum": "^3.58.0",
    "@aws-sdk/node-http-handler": "^3.54.0",
    "@azure/storage-blob": "^12.32.0",
    "@fragata/async-each": "^1.0.3",
    "@fragata/coalesce-calls": "^0.1.0",
    "@fragata/decorate-with": "^2.1.0",
    "@fragata/read-chunk": "^1.2.1",
    "@fragata/log": "^0.7.2",
    "bind-property-descriptor": "^2.0.0",
    "decorator-synchronized": "^0.6.0",
    "execa": "^5.0.0",
    "fs-extra": "^11.1.0",
    "get-stream": "^6.0.0",
    "limit-concurrency-decorator": "^0.6.0",
    "lodash": "^4.18.0",
    "promise-toolbox": "^0.21.0",
    "proper-lockfile": "^4.1.2",
    "readable-stream": "^4.1.0",
    "through2": "^4.0.2",
    "fragata-remote-parser": "^2.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.0",
    "@babel/core": "^7.29.0",
    "@babel/plugin-proposal-decorators": "^7.29.0",
    "@babel/plugin-proposal-function-bind": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "cross-env": "^7.0.2",
    "dotenv": "^16.0.0",
    "rimraf": "^6.0.1",
    "sinon": "^18.0.0",
    "tmp": "^0.2.1",
    "typescript": "~5.6.3"
  },
  "scripts": {
    "build": "cross-env NODE_ENV=production babel --source-maps --out-dir=dist/ src/ && tsc",
    "clean": "rimraf dist/",
    "dev": "cross-env NODE_ENV=development babel --watch --source-maps --out-dir=dist/ src/",
    "prebuild": "yarn run clean",
    "predev": "yarn run clean",
    "prepublishOnly": "yarn run build",
    "postversion": "npm publish",
    "test": "cd dist && node --test"
  },
  "author": {
    "name": "Vates SAS",
    "url": "https://vates.fr"
  },
  "exports": {
    ".": {
      "types": "./dist/fs.d.mts",
      "default": "./dist/index.js"
    },
    "./path": {
      "types": "./dist/path.d.mts",
      "default": "./dist/path.js"
    }
  }
}
