    "initiator",
    "chap",
    "scsi",
    "lun",
    "block",
    "storage"
  ],
  "dependencies": {
    "@fragata/async-each": "^1.0.3",
    "@fragata/read-chunk": "^1.2.1",
    "@fragata/disk-transform": "^1.3.4",
    "@fragata/log": "^0.7.2",
    "promise-toolbox": "^0.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.6",
    "typescript-eslint": "^8.61.0"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rimraf dist/",
    "dev": "tsc --watch",
    "postversion": "npm publish --access public",
